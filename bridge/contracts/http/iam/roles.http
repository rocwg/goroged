########################################################
# IAM · Role（角色）
#
# Domain
# - 角色生命周期管理
# - 角色基础信息管理
# - 用户与角色关系维护
# - 角色授权管理
#
# Consumer Contract
# 面向 Browser / App / BFF。
# Bridge 负责映射到 RoleService。
########################################################
# 最终结构
#
#Query
#
#    POST /roles/query
#    GET  /roles/{id}
#
#Command
#
#    POST
#    PUT
#    DELETE
#    DELETE(batch)
#
#Relationship
#    User（Increment）
#
#    Assigned Query
#    Candidate Query
#    Add
#    Remove
#
#Authorization
#    Menu + Permission（Replace）
#
#    GET /roles/{id}/authorization
#    PUT /roles/{id}/authorization
#
#Lookup
#    POST /roles/options/query
########################################################

@host=http://localhost:8080

########################################################
# Query（查询）
########################################################

###
# 角色分页查询
POST {{host}}/api/v1/iam/roles/query
Content-Type: application/json

{
  "page": 1,
  "size": 20,
  "name": "",
  "status": false
}

###
# 角色详情
GET {{host}}/api/v1/iam/roles/5

########################################################
# Command（变更）
########################################################

###
# 创建角色
POST {{host}}/api/v1/iam/roles
Content-Type: application/json

{
  "name": "",
  "remark": ""
}

###
# 修改角色
PUT {{host}}/api/v1/iam/roles/5
Content-Type: application/json

{
  "name": "",
  "remark": ""
}

###
# 删除角色（单个）
DELETE {{host}}/api/v1/iam/roles/5

###
# 批量删除角色
DELETE {{host}}/api/v1/iam/roles
Content-Type: application/json

{
  "roleIds": [
    4,
    5
  ]
}

########################################################
# Relationship（关系）
# 第二种：Relationship Increment（增量维护）
#
# 适用场景：Role ↔ User
########################################################

#################
# Relationship Query
#################

###
# 角色:用户（查询已关联对象）
POST {{host}}/api/v1/iam/roles/5/users/query
Content-Type: application/json

{
  "page": 1,
  "size": 20,
  "username": ""
}

###
# 角色:用户（查询可关联对象）
POST {{host}}/api/v1/iam/roles/5/candidate-users/query
Content-Type: application/json

{
  "page": 1,
  "size": 20,
  "username": ""
}

#################
# Command
#################

###
# 角色:用户（新增关联）
POST {{host}}/api/v1/iam/roles/5/users/add
Content-Type: application/json

{
  "userIds": [
    3,
    4
  ]
}

###
# 角色:用户（移除关联）
POST {{host}}/api/v1/iam/roles/5/users/remove
Content-Type: application/json

{
  "userIds": [
    3,
    4
  ]
}

########################################################
# Relationship（关系）
# 第一种：Relationship Replace（整体维护）
#
# 适用场景：Authorization（角色授权）
# Role ↔ Menu
# Role ↔ Permission
########################################################

###
# 查询角色授权信息
GET {{host}}/api/v1/iam/roles/5/authorization

###
# 更新角色授权
PUT {{host}}/api/v1/iam/roles/5/authorization
Content-Type: application/json

{
  "menuIds": [
    1,
    2,
    3
  ],
  "permissionIds": [
    100,
    101,
    102
  ]
}

########################################################
# Lookup（选择）
########################################################

###
# 角色选项查询
POST {{host}}/api/v1/iam/roles/options/query
Content-Type: application/json

{
  "name": "",
  "status": true,
  "limit": 20
}
